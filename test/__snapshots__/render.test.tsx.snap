// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`home > renders the start page with a saved name and rooms 1`] = `"<main class="center-card home"><h1 class="brand"><a class="brand-link" href="/" title="Home">Game Adda</a></h1><p class="muted">Card and board games for friends on voice chat. Everyone joins from their own device.</p><section class="my-rooms" aria-label="Your rooms"><h2>Your rooms</h2><ul><li class="my-room"><span class="grow"><span class="my-room-head"><span class="admin-mark" title="You are the admin">★</span><b>Box Office</b><span class="room-code"><b class="code">ABC234</b><button type="button" class="copy-code " title="Copy room code" aria-label="Copy room code"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon"><rect x="9" y="9" width="11" height="11" rx="2.5"></rect><path d="M5 15V6.5A2.5 2.5 0 0 1 7.5 4H15"></path></svg></button></span></span><small class="muted">Summer · season 2 of 4 · Asha (you), Bilal, Chitra</small><small class="expiry muted">Active 1 min ago · deleted in 6 days</small></span><span class="my-room-actions"><a class="btn small" href="#ABC234">↩ Rejoin</a><button type="button" class="btn small " title="Close room ABC234" aria-label="Close room ABC234">🗑</button></span></li></ul><p class="muted small">A room is deleted 6 days after anything last happened in it. Opening it and playing keeps it.</p></section><form><div class="you-row"><button type="button" class="avatar-btn look-btn" aria-haspopup="dialog" aria-label="Change your picture" title="Change your picture"><span class="avatar big" style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#553ae3fb</svg></span><span class="look-edit" aria-hidden="true">✎</span></button><label>Your name<input maxlength="20" placeholder="e.g. Chintu" value="Asha"></label></div><fieldset><legend>Theme</legend><h3 class="theme-game">Auction Adda</h3><label class="theme-pick on"><input type="radio" checked="" name="theme"><span><b>Box Office</b><small>Buy films, back the right star, sell them when the season ends.</small></span></label><label class="theme-pick "><input type="radio" name="theme"><span><b>Leather &amp; Willow</b><small>Bid for cricketers, back the right franchise, cash in when the tournament ends.</small></span></label><h3 class="theme-game">Pahunch</h3><label class="theme-pick "><input type="radio" name="theme"><span><b>Society Committee</b><small>Climb the housing society’s committees to the Chairman’s cabin. Votes have a price.</small></span></label></fieldset><button class="btn primary big">Create a room</button></form><form class="join-row"><label>Or join with a room code<input maxlength="6" placeholder="ABC234" class="code-input" value=""></label><button class="btn" disabled="">Join</button></form><p class="muted"><small>Free software under the AGPL-3.0. <a href="https://github.com/Dr-Blank/auction-adda">Source code</a></small></p></main>"`;

exports[`pahunch at seven seats (the other side of the board) > spectator 1`] = `"<div class="table ph-table  "><header class="topbar"><span class="brand"><a class="brand-link" href="/" title="Home">Game Adda</a></span><span class="round"><b>Gauri is asking for votes</b> · 👑 Chairman’s cabin 0/7</span><span class="grow"></span><button class="icon-btn" title="What happened" aria-label="Log">☰ <span class="lbl">Log</span></button><button class="icon-btn" title="Sound on" aria-label="Turn sound off">🔊</button><button class="icon-btn" aria-expanded="false" title="Room and rules" aria-label="Room and rules">? <span class="lbl">Room</span></button></header><div class="notices"><div class="notice">You are watching this game. Everyone’s izzat stays hidden.</div></div><section class="seats ph-players many" aria-label="Players"><div class="seat ph-seat-chip  owing  " data-seat="0" style="--seat: #e4572e; --seat-ink: #1a0d08;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About Asha"><span class="avatar on" style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#2bb40ffe</svg></span></button><svg class="ph-swatch" viewBox="-1.6 -1.6 3.2 3.2" aria-hidden="true"><path d="M-0.95 0a0.95 0.95 0 1 0 1.9 0a0.95 0.95 0 1 0 -1.9 0Z"></path></svg></div><button class="seat-body ph-seat-more" aria-haspopup="dialog"><span class="seat-name">Asha<span class="admin-mark">★</span><span class="mark now ph-mark-glyph" role="img" aria-label="votes">🗳️</span></span><span class="seat-line ph-counts"><span role="img" aria-label="5 still to place">✋ 5</span><span role="img" aria-label="0 at the top">▲ 0</span></span></button><button type="button" class="ph-fav-btn  " aria-haspopup="dialog" aria-label="Asha’s favour: Daddu’s chess partner, uses left hidden"><span class="ph-fav-glyph" aria-hidden="true">♞</span><span class="ph-fav-side" aria-hidden="true"><span class="ph-uses hidden" role="img" aria-label="uses left hidden">?</span></span></button></div><div class="seat ph-seat-chip    " data-seat="1" style="--seat: #4ea5d9; --seat-ink: #06141c;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About Farhan"><span class="avatar on" style="background: linear-gradient(170deg, #fdf1cf, #f0d993);"><svg viewBox="0 0 100 100" aria-hidden="true">#bd75d897</svg></span></button><svg class="ph-swatch" viewBox="-1.6 -1.6 3.2 3.2" aria-hidden="true"><path d="M0.00 -1.09L0.95 0.55L-0.95 0.55Z"></path></svg></div><button class="seat-body ph-seat-more" aria-haspopup="dialog"><span class="seat-name">Farhan</span><span class="seat-line ph-counts"><span role="img" aria-label="5 still to place">✋ 5</span><span role="img" aria-label="0 at the top">▲ 0</span></span></button><button type="button" class="ph-fav-btn  " aria-haspopup="dialog" aria-label="Farhan’s favour: Builder’s relative, uses left hidden"><span class="ph-fav-glyph" aria-hidden="true">+1</span><span class="ph-fav-side" aria-hidden="true"><span class="ph-uses hidden" role="img" aria-label="uses left hidden">?</span></span></button></div><div class="seat ph-seat-chip    " data-seat="2" style="--seat: #8cc152; --seat-ink: #0f1a06;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About Gauri"><span class="avatar on" style="background: linear-gradient(170deg, #dff1f0, #b9dcda);"><svg viewBox="0 0 100 100" aria-hidden="true">#ece9c322</svg></span></button><svg class="ph-swatch" viewBox="-1.6 -1.6 3.2 3.2" aria-hidden="true"><path d="M0.81 0.81L-0.81 0.81L-0.81 -0.81L0.81 -0.81Z"></path></svg></div><button class="seat-body ph-seat-more" aria-haspopup="dialog"><span class="seat-name">Gauri</span><span class="seat-line ph-counts"><span role="img" aria-label="5 still to place">✋ 5</span><span role="img" aria-label="0 at the top">▲ 0</span></span></button><button type="button" class="ph-fav-btn  " aria-haspopup="dialog" aria-label="Gauri’s favour: Daddu’s favourite, uses left hidden"><span class="ph-fav-glyph" aria-hidden="true">♥</span><span class="ph-fav-side" aria-hidden="true"><span class="ph-uses hidden" role="img" aria-label="uses left hidden">?</span></span></button></div><div class="seat ph-seat-chip    " data-seat="3" style="--seat: #c18ae0; --seat-ink: #1a0c22;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About Esha"><span class="avatar on" style="background: linear-gradient(170deg, #ece6f7, #d0c3ec);"><svg viewBox="0 0 100 100" aria-hidden="true">#5d2456d1</svg></span></button><svg class="ph-swatch" viewBox="-1.6 -1.6 3.2 3.2" aria-hidden="true"><path d="M1.14 0.00L0.00 1.14L-1.14 0.00L-0.00 -1.14Z"></path></svg></div><button class="seat-body ph-seat-more" aria-haspopup="dialog"><span class="seat-name">Esha</span><span class="seat-line ph-counts"><span role="img" aria-label="6 still to place">✋ 6</span><span role="img" aria-label="0 at the top">▲ 0</span></span></button><button type="button" class="ph-fav-btn  " aria-haspopup="dialog" aria-label="Esha’s favour: Kitty party host, uses left hidden"><span class="ph-fav-glyph" aria-hidden="true">⇄</span><span class="ph-fav-side" aria-hidden="true"><span class="ph-uses hidden" role="img" aria-label="uses left hidden">?</span></span></button></div><div class="seat ph-seat-chip    " data-seat="4" style="--seat: #f2c14e; --seat-ink: #1f1604;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About Dev"><span class="avatar on" style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#0fd19d14</svg></span></button><svg class="ph-swatch" viewBox="-1.6 -1.6 3.2 3.2" aria-hidden="true"><path d="M0.00 -1.14L0.28 -0.38L1.08 -0.35L0.45 0.15L0.67 0.92L0.00 0.47L-0.67 0.92L-0.45 0.15L-1.08 -0.35L-0.28 -0.38Z"></path></svg></div><button class="seat-body ph-seat-more" aria-haspopup="dialog"><span class="seat-name">Dev</span><span class="seat-line ph-counts"><span role="img" aria-label="4 still to place">✋ 4</span><span role="img" aria-label="0 at the top">▲ 0</span></span></button><button type="button" class="ph-fav-btn offered " aria-haspopup="dialog" aria-label="Dev’s favour: Fast-track, uses left hidden, on offer"><span class="ph-fav-glyph" aria-hidden="true">⏩</span><span class="ph-fav-side" aria-hidden="true"><span class="ph-uses hidden" role="img" aria-label="uses left hidden">?</span><small>on offer</small></span></button></div><div class="seat ph-seat-chip    " data-seat="5" style="--seat: #5fd3bc; --seat-ink: #05201b;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About Chitra"><span class="avatar on" style="background: linear-gradient(170deg, #e6f2e3, #c3ddbf);"><svg viewBox="0 0 100 100" aria-hidden="true">#f53baf90</svg></span></button><svg class="ph-swatch" viewBox="-1.6 -1.6 3.2 3.2" aria-hidden="true"><path d="M1.04 0.00L0.52 0.90L-0.52 0.90L-1.04 0.00L-0.52 -0.90L0.52 -0.90Z"></path></svg></div><button class="seat-body ph-seat-more" aria-haspopup="dialog"><span class="seat-name">Chitra</span><span class="seat-line ph-counts"><span role="img" aria-label="4 still to place">✋ 4</span><span role="img" aria-label="0 at the top">▲ 0</span></span></button><button type="button" class="ph-fav-btn  " aria-haspopup="dialog" aria-label="Chitra’s favour: Back-gate key, uses left hidden"><span class="ph-fav-glyph" aria-hidden="true">🔑</span><span class="ph-fav-side" aria-hidden="true"><span class="ph-uses hidden" role="img" aria-label="uses left hidden">?</span></span></button></div><div class="seat ph-seat-chip    " data-seat="6" style="--seat: #f28fb1; --seat-ink: #2a0b16;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About Bilal"><span class="avatar on" style="background: linear-gradient(170deg, #e3ecf7, #c4d4ec);"><svg viewBox="0 0 100 100" aria-hidden="true">#b20bad4c</svg></span></button><svg class="ph-swatch" viewBox="-1.
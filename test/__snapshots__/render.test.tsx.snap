"Kitty party invite: what it does"><span class="ph-key-glyph">✉</span> Kitty party invite</button><button type="button" class="ph-key-chip" aria-label="Favour returned: what it does"><span class="ph-key-glyph">↺</span> Favour returned</button></div></section><aside class="side ph-side"><section class="ph-tray owing" aria-label="You" style="--seat: #8cc152; --seat-ink: #0f1a06;"><div class="ph-tray-head"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About your seat"><span class="avatar on" style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#2bb40ffe</svg></span></button><svg class="ph-swatch" viewBox="-1.6 -1.6 3.2 3.2" aria-hidden="true"><path d="M0.81 0.81L-0.81 0.81L-0.81 -0.81L0.81 -0.81Z"></path></svg><div class="react-bar"><button type="button" class="react-badge " aria-expanded="false" title="React: float an emoji over your seat" aria-label="React"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon"><circle cx="12" cy="12" r="8.5"></circle><path d="M8.5 14a4.2 4.2 0 0 0 7 0"></path><path d="M9.5 9.8h0M14.5 9.8h0" stroke-width="2.6"></path></svg></button></div></div><button class="ph-tray-who" aria-haspopup="dialog"><span class="seat-name">You<span class="admin-mark">★</span></span><span class="ph-counts"><span role="img" aria-label="4 still to place">✋ 4</span><span role="img" aria-label="0 at the top">▲ 0</span></span></button><button type="button" class="ph-score" aria-haspopup="dialog" aria-label="Your izzat: 7"><span aria-hidden="true">🪙</span> <b>7</b></button></div><div class="ph-tokens ph-tray-tokens"><span class="ph-chip v1">1</span><span class="ph-chip v1">1</span><span class="ph-chip v1">1</span><span class="ph-chip v1">1</span><span class="ph-chip v3">3</span><button type="button" class="btn small ph-give">🎁 Give</button><button type="button" class="ph-tip-btn " aria-expanded="false" aria-label="Tip">💡</button></div><div class="ph-my-favour "><button type="button" class="ph-fav-name" aria-haspopup="dialog" aria-label="Your favour: Car-pool uncle, 2 of 2 uses left, each use earns you 1 izzat"><span class="ph-fav-glyph" aria-hidden="true">🚗</span><span aria-hidden="true"><b>Car-pool uncle</b><small><span class="ph-uses " role="img" aria-label="2 of 2 uses left">●●</span> +1 🪙</small></span></button><button type="button" class="ph-tip-btn " aria-expanded="false" aria-label="Tip">💡</button></div></section><div class="action-bar ph-bar your-turn"><div class="ph-moves ph-pick"><div class="ph-pick-head"><b class="ph-turn">Your move</b><span class="ph-hint">Tap a glowing room or <span class="ph-inline-face blocker" role="img" aria-label="Daddu"><span class="avatar " style="background: linear-gradient(170deg, #e7e7ea, #cbccd3);"><svg viewBox="0 0 100 100" aria-hidden="true">#3f139598</svg></span></span></span><button type="button" class="ph-tip-btn " aria-expanded="false" aria-label="Tip">💡</button><button type="button" class="btn small ghost ph-chipbtn" aria-expanded="false">All moves</button></div><div class="ph-on-offer" aria-label="Favours for your move"><span class="ph-offer asked">+1 Builder’s relative <small role="img" aria-label="asked Chitra, waiting">⏳ <span class="ph-inline-face" role="img" aria-label="Chitra"><span class="avatar " style="background: linear-gradient(170deg, #e6f2e3, #c3ddbf);"><svg viewBox="0 0 100 100" aria-hidden="true">#f53baf90</svg></span></span></small><button type="button" class="ph-offer-x" aria-label="Take back the request to Chitra">✕</button></span></div></div></div><section class="recent" aria-label="Latest"><h2>Latest</h2><ol><li class="log-request">You asked Chitra for their +1 Builder’s relative.</li><li class="log-done">Bilal ended the turn.</li><li class="log-request">Bilal asked you for your 🚗 Car-pool uncle.</li><li class="log-bonus">Bilal picked up ☕ Chai with <span class="ph-inline-face blocker" role="img" aria-label="Daddu"><span class="avatar " style="background: linear-gradient(170deg, #e7e7ea, #cbccd3);"><svg viewBox="0 0 100 100" aria-hidden="true">#3f139598</svg></span></span>: may also move <span class="ph-inline-face blocker" role="img" aria-label="Daddu"><span class="avatar " style="background: linear-gradient(170deg, #e7e7ea, #cbccd3);"><svg viewBox="0 0 100 100" aria-hidden="true">#3f139598</svg></span></span> this turn.</li><li class="log-climb">Bilal moved up from the 🚙 Parking sub-committee to the 🏏 Sports in-charge and took a token.</li></ol><button class="btn small ghost">Full log</button></section></aside></div>"`;

exports[`pahunch pages > favour-offered 1`] = `"<div class="table ph-table acting "><header class="topbar"><span class="brand"><a class="brand-link" href="/" title="Home">Game Adda</a></span><span class="round"><b>You to move</b> · 👑 Chairman’s cabin 0/5</span><span class="grow"></span><button class="icon-btn" title="Freeze the game: the clock, the bots and all moves wait" aria-label="Freeze the game"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon"><path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9"></path><path d="M9.5 4.5L12 7l2.5-2.5M9.5 19.5L12 17l2.5 2.5"></path></svg> <span class="lbl">Freeze</span></button><button class="icon-btn" title="What happened" aria-label="Log">☰ <span class="lbl">Log</span></button><button class="icon-btn" title="Sound on" aria-label="Turn sound off">🔊</button><button class="icon-btn" aria-expanded="false" title="Room and rules" aria-label="Room and rules">? <span class="lbl">Room</span></button></header><div class="notices"></div><section class="seats ph-players" aria-label="Players"><div class="seat ph-seat-chip    " data-seat="0" style="--seat: #e4572e; --seat-ink: #1a0d08;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About Chitra"><span class="avatar on" style="background: linear-gradient(170deg, #e6f2e3, #c3ddbf);"><svg viewBox="0 0 100 100" aria-hidden="true">#f53baf90</svg></span></button><svg class="ph-swatch" viewBox="-1.6 -1.6 3.2 3.2" aria-hidden="true"><path d="M-0.95 0a0.95 0.95 0 1 0 1.9 0a0.95 0.95 0 1 0 -1.9 0Z"></path></svg></div><button class="seat-body ph-seat-more" aria-haspopup="dialog"><span class="seat-name">Chitra</span><span class="seat-line ph-counts"><span role="img" aria-label="5 still to place">✋ 5</span><span role="img" aria-label="0 at the top">▲ 0</span></span></button><button type="button" class="ph-fav-btn  live" aria-haspopup="di
t: 14.14734951686114%; animation-delay: 1539.5132094388828ms; animation-duration: 2586.990858381614ms; --spin: 102deg; --drift: -17px;"></i><i class="c2" style="left: 54.55937671940774%; animation-delay: 1732.9953133128583ms; animation-duration: 2300.9973482694477ms; --spin: -281deg; --drift: -26px;"></i><i class="c3" style="left: 68.09252433013171%; animation-delay: 940.8935726154596ms; animation-duration: 2939.4757573492825ms; --spin: -87deg; --drift: 22px;"></i><i class="c4" style="left: 26.30140222609043%; animation-delay: 975.192808220163ms; animation-duration: 3597.8816071990877ms; --spin: 344deg; --drift: -39px;"></i><i class="c0" style="left: 86.08166712801903%; animation-delay: 1001.0830763261765ms; animation-duration: 2748.0466410517693ms; --spin: 77deg; --drift: 2px;"></i><i class="c1" style="left: 38.45421082805842%; animation-delay: 1541.3176127476618ms; animation-duration: 2388.3032562676817ms; --spin: -155deg; --drift: 37px;"></i></div><p class="muted ph-eligible">Only players with a resident in the Chairman’s cabin could win.</p><h2>Chitra wins!</h2><ol class="podium"><li class="place place-2" style="--d: 350ms;"><span class="avatar " style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#2bb40ffe</svg></span><span class="who">Asha<em> (you)</em></span><b class="money">0 izzat</b><span class="block" aria-label="Place 2">2</span></li><li class="place place-1" style="--d: 650ms;"><span class="crown" title="Winner"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon"><path d="M4 8l4 4 4-6.5 4 6.5 4-4-1.6 9.5H5.6z"></path><path d="M6 20.5h12"></path></svg></span><span class="avatar " style="background: linear-gradient(170deg, #e6f2e3, #c3ddbf);"><svg viewBox="0 0 100 100" aria-hidden="true">#f53baf90</svg></span><span class="who">Chitra</span><b class="money">0 izzat</b><span class="block" aria-label="Place 1">1</span></li><li class="place place-3" style="--d: 0ms;"><span class="avatar " style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#0fd19d14</svg></span><span class="who">Dev</span><b class="money">0 izzat</b><span class="block" aria-label="Place 3">3</span></li></ol><ol class="also-ran" start="4"><li value="4"><span>Bilal</span><b>12 izzat</b></li></ol><div class="row gameover-next"><button type="button" class="btn primary big">Play again</button><button type="button" class="btn big" title="Back to the lobby with the same players: change the theme, cast, clock or players">Change setup</button></div></div></section><aside class="side ph-side"><section class="ph-purse" aria-label="Your izzat"><h2>Your izzat <b>16</b></h2><div class="ph-tokens"><span class="ph-chip v1">1</span><span class="ph-chip v1">1</span><span class="ph-chip v1">1</span><span class="ph-chip v1">1</span><span class="ph-chip v1">1</span><span class="ph-chip v1">1</span><span class="ph-chip v1">1</span><span class="ph-chip v2">2</span><span class="ph-chip v2">2</span><span class="ph-chip v2">2</span><span class="ph-chip v3">3</span></div><p class="muted small">Everyone’s tokens show now.</p></section><section class="recent" aria-label="Latest"><h2>Latest</h2><ol><li class="log-end">Chitra won.</li><li class="log-climb">Chitra moved up from the Secretary’s chair to the Chairman’s cabin.</li><li class="log-climb">Dev moved up from the Managing committee to the Chairman’s cabin.</li><li class="log-climb">You moved up from the Lift committee to the Garden committee and took 2 izzat.</li><li class="log-fail">The vote failed: Bilal stays in the Festival committee.</li><li class="log-vote">Dev voted no.</li></ol><button class="btn small ghost">Full log</button></section></aside></div>"`;

exports[`pahunch pages > spectator 1`] = `"<div class="table ph-table  "><header class="topbar"><span class="brand"><a class="brand-link" href="/" title="Home">Game Adda</a></span><span class="round"><b>Dev is asking for votes</b> · Chairman’s cabin 0/5</span><span class="grow"></span><button class="icon-btn" title="What happened" aria-label="Log">☰ <span class="lbl">Log</span></button><button class="icon-btn" title="Sound on" aria-label="Turn sound off">🔊</button><button class="icon-btn" aria-expanded="false" title="Room and rules" aria-label="Room and rules">? <span class="lbl">Room</span></button></header><div class="notices"><div class="notice">You are watching this game. Everyone’s izzat stays hidden.</div></div><section class="seats ph-players" aria-label="Players"><div class="seat ph-seat-chip  owing  " data-seat="0" style="--seat: #e4572e; --seat-ink: #1a0d08;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About Bilal"><span class="avatar on" style="background: linear-gradient(170deg, #e3ecf7, #c4d4ec);"><svg viewBox="0 0 100 100" aria-hidden="true">#b20bad4c</svg></span></button><span class="ph-swatch" aria-hidden="true">B</span></div><div class="seat-body"><div class="seat-name">Bilal<span class="mark now">votes</span></div><div class="seat-line ph-counts"><span title="residents still to place">✋ 5</span><span title="residents in the Chairman’s cabin">▲ 0</span></div></div></div><div class="seat ph-seat-chip    " data-seat="1" style="--seat: #4ea5d9; --seat-ink: #06141c;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About Asha"><span class="avatar on" style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#2bb40ffe</svg></span></button><span class="ph-swatch" aria-hidden="true">A</span></div><div class="seat-body"><div class="seat-name">Asha<span class="admin-mark">★</span></div><div class="seat-line ph-counts"><span title="residents still to place">✋ 5</span><span title="residents in the Chairman’s cabin">▲ 0</span></div></div></div><div class="seat ph-seat-chip    " data-seat="2" style="--seat: #8cc152; --seat-ink: #0f1a06;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About Dev"><span class="avatar on" style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#0fd19d14</svg></span></button><span class="ph-swatch" aria-hidden="true">D</span></div><div class="seat-body"><div class="seat-name">Dev</div><div class="seat-line ph-counts"><span title="residents still to place">✋ 5</span><span title="residents in the Chairman’s cabin">▲ 0</span></div></div></div><div class="seat ph-seat-chip    " data-seat="3" style="--seat: #c18ae0; --seat-ink: #1a0c22;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About Chitra"><span class="avatar on" style="background: linear-gradient(170deg, #e6f2e3, #c3ddbf);"><svg viewBox="0 0 100 100" aria-hidden="true">#f53baf90</svg></span></button><span class="ph-swatch" aria-hidden="true">C</span></div><div class="seat-body"><div class="seat-name">Chitra</div><div class="seat-line ph-counts"><span title="residents still to place">✋ 6</span><span title="residents in the Chairman’s cabin">▲ 0</span></div></div></div></section><section class="stage ph-stage "><div class="ph-vote" aria-live="polite"><h2>Dev wants to move up from the Lift committee to the Treasurer’s desk</h2><p class="ph-tally"><b>1</b> yes so far, <b>2</b> needed<span class="ph-clock"> · ⏱ 12 s</span></p><ul class="ph-voters"><li style="--seat: #e4572e;"><span class="ph-dot" aria-hidden="true"></span>Bilal ×1: <em>thinking…</em></li><li style="--seat: #8cc152;"><span class="ph-dot" aria-hidden="true"></span>Dev ×1: yes (own)</li></ul></div><svg class="ph-board" viewBox="-3.3000000000000007 -1.5 103.89999999999999 101" role="group" aria-label="The board: Classic">#34309cf7</svg></section><aside class="side ph-side"><section class="recent" aria-label="Latest"><h2>Latest</h2><ol><li class="log-ask">Dev asked to move up from the Lift committee to the Treasurer’s desk: 2 votes needed.</li><li class="log-enter">Asha joined the Water tank committee.</li><li class="log-enter">Bilal joined the Lift committee.</li><li class="log-reward">Chitra earned 1 izzat.</li><li class="log-nudge">Chitra nudged an aunty up from the Parking sub-committee to the Garden committee and took 1 izzat.</li><li class="log-enter">Dev joined the Lift committee.</li></ol><button class="btn small ghost">Full log</button></section></aside></div>"`;


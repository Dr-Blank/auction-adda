="true">#b1673fd0</svg></svg></g></g><g class="ph-token ph-under v3"><circle class="ph-coin-rim" cx="50.6" cy="56.75" r="1.65"></circle><circle class="ph-coin" cx="50.6" cy="56.75" r="1.3"></circle><text x="50.6" y="57.35">3</text></g></g></g></svg><div class="ph-coin-key"><button type="button" class="ph-key-chip" aria-label="Kitty party invite: what it does"><span class="ph-key-glyph">✉</span> Kitty party invite</button><button type="button" class="ph-key-chip" aria-label="Favour returned: what it does"><span class="ph-key-glyph">↺</span> Favour returned</button></div></section><aside class="side ph-side"><div class="ph-vote" aria-live="polite"><h2 class="ph-vote-move"><span class="ph-face" style="--seat: #c18ae0;"><span class="avatar " style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#0fd19d14</svg></span></span><span class="ph-vote-rooms" aria-hidden="true"><span class="ph-vote-icon">💬</span><span class="ph-vote-arrow">➜</span><span class="ph-vote-icon">🪔</span></span><span class="sr-only">Dev wants to move up: 💬 Residents’ WhatsApp group to 🪔 Festival committee</span><span class="ph-clock" role="img" aria-label="12 seconds left"><svg viewBox="0 0 40 40" aria-hidden="true">#fbc04c09</svg><span class="ph-clock-secs" aria-hidden="true">12</span></span></h2><p class="ph-pips" role="img" aria-label="2 of 3 yes"><span class="on"></span><span class="on"></span><span class=""></span></p><ul class="ph-voters"><li class="ph-voter wait" style="--seat: #4ea5d9;" aria-label="Bilal, 2 in the room: thinking"><span class="ph-face"><span class="avatar " style="background: linear-gradient(170deg, #e3ecf7, #c4d4ec);"><svg viewBox="0 0 100 100" aria-hidden="true">#b20bad4c</svg></span><span class="ph-count">×2</span><span class="ph-said" aria-hidden="true">⏳</span></span></li><li class="ph-voter wait" style="--seat: #8cc152;" aria-label="You, 1 in the room: thinking"><span class="ph-face"><span class="avatar " style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#2bb40ffe</svg></span><span class="ph-said" aria-hidden="true">⏳</span></span></li><li class="ph-voter own" style="--seat: #c18ae0;" aria-label="Dev, 2 in the room: yes (own)"><span class="ph-face"><span class="avatar " style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#0fd19d14</svg></span><span class="ph-count">×2</span><span class="ph-said" aria-hidden="true">⬆</span></span></li></ul></div><section class="ph-tray owing" aria-label="You" style="--seat: #8cc152; --seat-ink: #0f1a06;"><div class="ph-tray-head"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About your seat"><span class="avatar on" style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#2bb40ffe</svg></span></button><svg class="ph-swatch" viewBox="-1.6 -1.6 3.2 3.2" aria-hidden="true"><path d="M0.81 0.81L-0.81 0.81L-0.81 -0.81L0.81 -0.81Z"></path></svg><div class="react-bar"><button type="button" class="react-badge " aria-expanded="false" title="React: float an emoji over your seat" aria-label="React"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon"><circle cx="12" cy="12" r="8.5"></circle><path d="M8.5 14a4.2 4.2 0 0 0 7 0"></path><path d="M9.5 9.8h0M14.5 9.8h0" stroke-width="2.6"></path></svg></button></div></div><button class="ph-tray-who" aria-haspopup="dialog"><span class="seat-name">You<span class="admin-mark">★</span></span><span class="ph-counts"><span role="img" aria-label="3 still to place">✋ 3</span><span role="img" aria-label="1 at the top">▲ 1</span></span></button><button type="button" class="ph-score" aria-haspopup="dialog" aria-label="Your izzat: 11"><span aria-hidden="true">🪙</span> <b>11</b></button></div><div class="ph-tokens ph-tray-tokens"><span class="ph-chip v1">1</span><span class="ph-chip v1">1</span><span class="ph-chip v1">1</span><span class="ph-chip v1">1</span><span class="ph-chip v2">2</span><span class="ph-chip v5">5</span><button type="button" class="btn small ph-give">🎁 Give</button><button type="button" class="ph-tip-btn " aria-expanded="false" aria-label="Tip">💡</button></div><div class="ph-my-favour "><button type="button" class="ph-fav-name" aria-haspopup="dialog" aria-label="Your favour: Car-pool uncle, 2 of 2 uses left, each use earns you 1 izzat"><span class="ph-fav-glyph" aria-hidden="true">🚗</span><span aria-hidden="true"><b>Car-pool uncle</b><small><span class="ph-uses " role="img" aria-label="2 of 2 uses left">●●</span> +1 🪙</small></span></button><button type="button" class="btn primary" aria-pressed="false" aria-label="Offer your Car-pool uncle to Dev">🤝 Offer 🚗 → <span class="ph-inline-face" role="img" aria-label="Dev"><span class="avatar " style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#0fd19d14</svg></span></span></button><button type="button" class="ph-tip-btn " aria-expanded="false" aria-label="Tip">💡</button></div></section><div class="action-bar ph-bar your-turn"><div class="ph-moves" role="group" aria-label="Your vote"><div class="ph-pick-head"><b class="ph-turn">🗳️ Your vote</b><span class="ph-pick-what">1 in 💬 WhatsApp · a needed yes earns 1 izzat</span><button type="button" class="ph-tip-btn " aria-expanded="false" aria-label="Tip">💡</button></div><div class="ph-move-grid"><button class="btn primary">✓ Yes</button><button class="btn">✗ No</button></div></div></div><section class="recent" aria-label="Latest"><h2>Latest</h2><ol><li class="log-ask">Dev asked to move up from the 💬 Residents’ WhatsApp group to the 🪔 Festival committee: 3 votes needed.</li><li class="log-climb">You moved up from the 🛡️ Security committee to the 👑 Chairman’s cabin with the votes and took 2 izzat.</li><li class="log-bribe">You sent an <span class="ph-inline-who"><span class="ph-inline-face neutral" aria-hidden="true"><span class="avatar " style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#556897a1</svg></span></span>aunty</span> a box of kaju katli.</li><li class="log-decline">Bilal said no to lending their favour.</li><li class="log-ask">You asked to move up from the 🛡️ Security committee to the 👑 Chairman’s cabin: 2 votes needed.</li></ol><button class="btn small ghost">Full log</button></section></aside></div>"`;

exports[`pahunch pages > vote-voter on a phone 1`] = `"<div class="table ph-table acting "><header class="topbar"><span class="brand"><a class="brand-link" href="/" title="Home">Game Adda</a></span><span class="round"><b>Dev is asking for votes</b> · 👑 Chairman’s cabin 1/5</span><span class="grow"></span><button class="icon-btn" title="Freeze the game: the clock, the bots and all moves wait" aria-label="Freeze the game"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon"><path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9"></path><path d="M9.5 4.5L12 7l2.5-2.5M9.5 19.5L12 17l2.5 2.5"></path></svg> <span class="lbl">Freeze</span></button><button class="icon-btn" title="What happened" aria-label="Log">☰ <span class="lbl">Log</span></button><button class="icon-btn" title="Sound on" aria-label="Turn sound off">🔊</button><button class="icon-btn" aria-expanded="false" title="Room and rules" aria-label="Room and rules">? <span class="lbl">Room</span></button></header><div class="notices"></div><section class="seats ph-players" aria-label="Players"><div class="seat ph-seat-chip    " data-seat="0" style="--seat: #e4572e; --seat-ink: #1a0d08;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About Chitra"><span class="avatar on" style="background: linear-gradient(170deg, #e6f2e3, #c3ddbf);"><svg viewBox="0 0 100 100" aria-hidden="true">#f53baf90</svg></span></button><svg class="ph-swatch" viewBox="-1.6 -1.6 3.2 3.2" aria-hidden="true"><path d="M-0.95 0a0.95 0.95 0 1 0 1.9 0a0.95 0.95 0 1 0 -1.9 0Z"></path></svg></div><button class="seat-body ph-seat-more" aria-haspopup="dialog"><span class="seat-name">Chitra</span><span class="seat-line ph-counts"><span role="img" aria-label="1 still to place">✋ 1</span><span role="img" aria-label="0 at the top">▲ 0</span></span></button><button type="button" class="ph-fav-btn offer
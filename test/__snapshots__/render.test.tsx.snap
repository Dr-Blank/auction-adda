="round" stroke-linejoin="round" aria-hidden="true" class="icon"><circle cx="12" cy="12" r="8.5"></circle><path d="M8.5 14a4.2 4.2 0 0 0 7 0"></path><path d="M9.5 9.8h0M14.5 9.8h0" stroke-width="2.6"></path></svg></button></div></div><button class="ph-tray-who" aria-haspopup="dialog"><span class="seat-name">You<span class="admin-mark">★</span></span><span class="ph-counts"><span role="img" aria-label="5 still to place">✋ 5</span><span role="img" aria-label="0 at the top">▲ 0</span></span></button><button type="button" class="ph-score" aria-haspopup="dialog" aria-label="Your izzat: 4"><span aria-hidden="true">🪙</span> <b>4</b></button></div><div class="ph-tokens ph-tray-tokens"><span class="ph-chip v1">1</span><span class="ph-chip v1">1</span><span class="ph-chip v1">1</span><span class="ph-chip v1">1</span><button type="button" class="btn small ph-give">🎁 Give</button><button type="button" class="ph-tip-btn " aria-expanded="false" aria-label="Tip">💡</button></div><div class="ph-my-favour "><button type="button" class="ph-fav-name" aria-haspopup="dialog" aria-label="Your favour: Car-pool uncle, 2 of 2 uses left, each use earns you 1 izzat"><span class="ph-fav-glyph" aria-hidden="true">🚗</span><span aria-hidden="true"><b>Car-pool uncle</b><small><span class="ph-uses " role="img" aria-label="2 of 2 uses left">●●</span> +1 🪙</small></span></button><button type="button" class="ph-tip-btn " aria-expanded="false" aria-label="Tip">💡</button></div></section><div class="action-bar ph-bar your-turn"><div class="ph-moves ph-pick"><div class="ph-pick-head"><b class="ph-turn">Extra move</b><span class="ph-hint">Use a glowing move, or end your turn</span><button type="button" class="ph-tip-btn " aria-expanded="false" aria-label="Tip">💡</button></div><div class="ph-on-offer" aria-label="Favours for your move"><span class="ph-offer">♞ Daddu’s chess partner <span class="ph-inline-face" role="img" aria-label="Dev"><span class="avatar " style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#0fd19d14</svg></span></span><button type="button" class="ph-offer-x" aria-label="Turn down Dev’s Daddu’s chess partner">✕</button></span></div><button type="button" class="btn primary ph-done">⏭ End turn</button></div></div><section class="recent" aria-label="Latest"><h2>Latest</h2><ol><li class="log-reward">You earned 1 izzat.</li><li class="log-nudge">You nudged an <span class="ph-inline-who"><span class="ph-inline-face neutral" aria-hidden="true"><span class="avatar " style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#556897a1</svg></span></span>aunty</span> up from the 🪔 Festival committee to the 🛡️ Security committee and took 1 izzat.</li><li class="log-climb">Bilal moved up from the 🎫 Gate pass desk to the 🌳 Garden committee.</li><li class="log-climb">Chitra moved up from the 🛗 Lift in-charge to the 🪔 Festival committee.</li><li class="log-enter">Dev joined the 💬 Residents’ WhatsApp group.</li></ol><button class="btn small ghost">Full log</button></section></aside></div>"`;

exports[`pahunch pages > your-move 1`] = `"<div class="table ph-table acting "><header class="topbar"><span class="brand"><a class="brand-link" href="/" title="Home">Game Adda</a></span><span class="round"><b>You to move</b> · 👑 Chairman’s cabin 0/5</span><span class="grow"></span><button class="icon-btn" title="Freeze the game: the clock, the bots and all moves wait" aria-label="Freeze the game"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon"><path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9"></path><path d="M9.5 4.5L12 7l2.5-2.5M9.5 19.5L12 17l2.5 2.5"></path></svg> <span class="lbl">Freeze</span></button><button class="icon-btn" title="What happened" aria-label="Log">☰ <span class="lbl">Log</span></button><button class="icon-btn" title="Sound on" aria-label="Turn sound off">🔊</button><button class="icon-btn" aria-expanded="false" title="Room and rules" aria-label="Room and rules">? <span class="lbl">Room</span></button></header><div class="notices"></div><section class="seats ph-players" aria-label="Players"><div class="seat ph-seat-chip    " data-seat="0" style="--seat: #e4572e; --seat-ink: #1a0d08;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About Chitra"><span class="avatar on" style="background: linear-gradient(170deg, #e6f2e3, #c3ddbf);"><svg viewBox="0 0 100 100" aria-hidden="true">#f53baf90</svg></span></button><svg class="ph-swatch" viewBox="-1.6 -1.6 3.2 3.2" aria-hidden="true"><path d="M-0.95 0a0.95 0.95 0 1 0 1.9 0a0.95 0.95 0 1 0 -1.9 0Z"></path></svg></div><button class="seat-body ph-seat-more" aria-haspopup="dialog"><span class="seat-name">Chitra</span><span class="seat-line ph-counts"><span role="img" aria-label="5 still to place">✋ 5</span><span role="img" aria-label="0 at the top">▲ 0</span></span></button><button type="button" class="ph-fav-btn  live" aria-haspopup="dialog" aria-label="Chitra’s favour: Builder’s relative, uses left hidden"><span class="ph-fav-glyph" aria-hidden="true">+1</span><span class="ph-fav-side" aria-hidden="true"><span class="ph-uses hidden" role="img" aria-label="uses left hidden">?</span></span></button></div><div class="seat ph-seat-chip    " data-seat="1" style="--seat: #4ea5d9; --seat-ink: #06141c;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About Bilal"><span class="avatar on" style="background: linear-gradient(170deg, #e3ecf7, #c4d4ec);"><svg viewBox="0 0 100 100" aria-hidden="true">#b20bad4c</svg></span></button><svg class="ph-swatch" viewBox="-1.6 -1.6 3.2 3.2" aria-hidden="true"><path d="M0.00 -1.09L0.95 0.55L-0.95 0.55Z"></path></svg></div><button class="seat-body ph-seat-more" aria-haspopup="dialog"><span class="seat-name">Bilal</span><span class="seat-line ph-counts"><span role="img" aria-label="4 still to place">✋ 4</span><span role="img" aria-label="0 at the top">▲ 0</span></span></button><button type="button" class="ph-fav-btn  live" aria-haspopup="dialog" aria-label="Bilal’s favour: Kitty party host, uses left hidden"><span class="ph-fav-glyph" aria-hidden="true">⇄</span><span class="ph-fav-side" aria-hidden="true"><span class="ph-uses hidden" role="img" aria-label="uses left hidden">?</span></span></button></div><div class="seat ph-seat-chip    " data-seat="3" style="--seat: #c18ae0; --seat-ink: #1a0c22;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About Dev"><span class="avatar on" style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#0fd19d14</svg></span></button><svg class="ph-swatch" viewBox="-1.6 -1.6 3.2 3.2" aria-hidden="true"><path d="M1.14 0.00L0.00 1.14L-1.14 0.00L-0.00 -1.14Z"></path></svg></div><button class="seat-body ph-seat-more" aria-haspopup="dialog"><span class="seat-name">Dev</span><span class="seat-line ph-counts"><span role="img" a
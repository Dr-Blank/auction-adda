exports[`room pages > open-buying-bid 1`] = `"<div class="table  "><header class="topbar"><span class="brand"><a class="brand-link" href="/" title="Home">Game Adda</a></span><button type="button" class="round round-btn" title="All seasons: the deal, the scoring and where the game is" aria-haspopup="dialog"><svg class="round-ring" viewBox="0 0 22 22" width="22" height="22" aria-hidden="true">#2cbf88b0</svg><b>Sankranti</b> · season 1 of 4</button><span class="grow"></span><button class="icon-btn" title="Freeze the game: the clock, the bots and all moves wait" aria-label="Freeze the game"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon"><path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9"></path><path d="M9.5 4.5L12 7l2.5-2.5M9.5 19.5L12 17l2.5 2.5"></path></svg> <span class="lbl">Freeze</span></button><button class="icon-btn" title="Auction log" aria-label="Auction log">☰ <span class="lbl">Log</span></button><button class="icon-btn" title="Sound on" aria-label="Turn sound off">🔊</button><button class="icon-btn" aria-expanded="false" title="Room and rules" aria-label="Room and rules">? <span class="lbl">Room</span></button></header><div class="notices"></div><section class="seats arc" aria-label="Players"><div class="seat     " data-seat="2" style="--arc: 0.500;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About Dev"><span class="avatar on" title="Connected" style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#0fd19d14</svg></span></button></div><div class="seat-body"><div class="seat-name">Dev</div><div class="seat-line"><span class="backs" title="8 films in hand"><i></i><i></i><i></i><i></i><i></i><b>8</b></span></div><button class="owned " data-owned="2" aria-label="Dev bought 1 film: 1 Pappu Pandey" aria-expanded="false"><span class="mini-card n1" style="--suit: #2f9c84; color: #03211b;"><span class="mc-glyph">●</span><span class="mc-short">PP</span></span></button></div></div><div class="seat    out " data-seat="3" style="--arc: 1.000;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About Bilal"><span class="avatar on" title="Connected" style="background: linear-gradient(170deg, #e3ecf7, #c4d4ec);"><svg viewBox="0 0 100 100" aria-hidden="true">#b20bad4c</svg></span></button><span class="role" title="Seller">🔨</span></div><div class="seat-body"><div class="seat-name">Bilal<span class="mark">done</span></div><div class="seat-line"><span class="backs" title="8 films in hand"><i></i><i></i><i></i><i></i><i></i><b>8</b></span></div><div class="owned" data-owned="3" aria-label="Bilal has bought no films this season" title="Bilal has bought no films this season"><span class="mini-card empty" aria-hidden="true"></span></div></div></div><div class="seat  owing   " data-seat="0" style="--arc: 0.500;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About Chitra"><span class="avatar on" title="Connected" style="background: linear-gradient(170deg, #e6f2e3, #c3ddbf);"><svg viewBox="0 0 100 100" aria-hidden="true">#f53baf90</svg></span></button></div><div class="seat-body"><div class="seat-name">Chitra<span class="mark now">bidding</span></div><div class="seat-tag" title="The hammer passes clockwise to the next player who still has cards">Sells next</div><div class="seat-line"><span class="backs" title="9 films in hand"><i></i><i></i><i></i><i></i><i></i><b>9</b></span></div><button class="owned " data-owned="0" aria-label="Chitra bought 1 film: 1 Rajkumari Ratnavali" aria-expanded="false"><span class="mini-card n1" style="--suit: #a35cc2; color: #fff;"><span class="mc-glyph">♛</span><span class="mc-short">RR</span></span></button></div></div></section><section class="stage  stage-open"><div class="lot-row"><div class="lot-posters"><div><div class="poster poster-lg bo" style="--g: #1e0f0c; --h: #d0583f; --t: #f7dccf;" title="Hawala Highway — Bijli Bhullar (Action) — Open Auction"><svg class="poster-art" viewBox="0 0 120 168" preserveAspectRatio="xMidYMid slice" aria-hidden="true">#8416bce1</svg><div class="poster-type"><b>⇈</b><span>Open Auction</span></div><div class="poster-code">BB</div><div class="poster-foot"><div class="bo-billing">Bijli Bhullar</div><div class="poster-title">Hawala Highway</div><div class="bo-rule"></div><div class="poster-tag">Every bullet has a backstory.</div></div><svg class="bo-frame" viewBox="0 0 120 168" preserveAspectRatio="none" aria-hidden="true">#92dc58e6</svg></div></div></div><div class="lot-info"><div class="kind-label" title="Anyone can raise at any time. Done takes you out until you bid again. It sells when everyone else is done or the bid timer runs out."><span class="type-icon">⇈</span> Open Auction<button class="info-btn tap-only" aria-label="Open Auction: how auction types work"><i class="i-dot">i</i></button></div><div class="price"><b class="pop">₹3 cr</b><span>Dev leads</span></div><div class="seller">🔨 Seller: Bilal<span class="next-seller" title="The hammer passes clockwise to the next player who still has cards"> · Next seller: <b>Chitra</b></span><span class="hint"> · Anyone can raise at any time. Done takes you out until you bid again. It sells when everyone else is done or the bid timer runs out.</span></div><ol class="rail rail-open" aria-label="Order round the table"><li class="stop waiting "><span class="avatar small" style="background: linear-gradient(170deg, #e6f2e3, #c3ddbf);"><svg viewBox="0 0 100 100" aria-hidden="true">#f53baf90</svg></span><span class="stop-name">Chitra</span><span class="stop-state"></span></li><li class="stop done me"><span class="avatar small" style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#2bb40ffe</svg></span><span class="stop-name">You</span><span class="stop-state">done</span></li><li class="stop lead "><span class="avatar small" style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#0fd19d14</svg></span><span class="stop-name">Dev</span><span class="stop-state">₹3 cr ▲</span></li><li class="stop done "><span class="avatar small" style="background: linear-gradient(170deg, #e3ecf7, #c4d4ec);"><svg viewBox="0 0 100 100" aria-hidden="true">#b20bad4c</svg></span><span class="stop-name">Bilal 🔨</span><span class="stop-state">done</span></li></ol></div></div><div class="action-bar "><form class="bidbox"><div class="bid-amount"><button type="button" class="step" disabled="" aria-label="One less">−</button><label class="amount"><span class="cur" aria-hidden="true">₹</span><input inputmode="numeric" pattern="[0-9]*" aria-label="Bid amount" type="text" value="4"><span class="cur" aria-hidden="true"> cr</span><span class="of">of ₹117 cr</span></label><button type="button" class="step" aria-label="One more">+</button></div><div class="quick"><button type="button" class="chip-btn">+5</button><button type="button" class="chip-btn">+10</button><button type="button" class="chip-btn" disabled="">min</button></div><div class="act-row"><button class="btn primary big">Bid ₹4 cr <kbd>Enter</kbd></button></div><p class="hint">You are done: raises do not bring you back. Bid to come back in. Waiting for Chitra… <span class="bid-clock  " title="When this runs out, everyone still in is done"><span class="secs">12s</span><span class="drain" aria-hidden="true"><span style="animation-duration: 30000ms; animation-delay: -18000ms; animation-play-state: running;"></span></span></span></p></form></div><details class="ruling"><summary><span aria-hidden="true">🔨</span> Call it from voice <small>admin</small></summary><form class="ruling-row"><label>Sold to<select><option value="0">Chitra</option><option value="1">You</option><option value="2">Dev</option><option value="3">Bilal (seller)</option><option value="none">Nobody (seller keeps it free)</option></select></label><label>for<input class="ruling-price" inputmode="numeric" type="text" value="3"></label><button class="btn">Call it…</button><p class="hint">Ends this auction now, whatever the buttons say. Everyone sees that you called it. You can undo it until anyone moves.</p></form></details></section><section class="hand-panel  "><div class="hand-head"><div class="seat me   out " data-seat="1" style="--arc: 1.000;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About your seat"><span class="avatar on" title="Connected" style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#2bb40ffe</svg></span></button><div class="react-bar"><button type="button" class="react-badge " aria-expanded="false" title="React: float an emoji over your seat" aria-label="React"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon"><circle cx="12" cy="12" r="8.5"></circle><path d="M8.5 14a4.2 4.2 0 0 0 7 0"></path><path d="M9.5 9.8h0M14.5 9.8h0" stroke-width="2.6"></path></svg></button></div></div><div class="seat-body"><div class="seat-name">You<span class="admin-mark" title="Room admin: can call results agreed on voice">★</span><span class="mark">done</span></div><div class="seat-tag" title="The hammer passes clockwise to the next player who still has cards">You sell in 2 lots</div><div class="owned" data-owned="1" aria-label="You have bought no films this season" title="You have bought no films this season"><span class="mini-card empty" aria-hidden="true"></span></div></div></div><h2>Your hand <small>8</small></h2><button class="info-btn tap-only" aria-label="What the auction icons mean"><i class="i-dot">i</i> <span>Icons</span></button><span class="grow"></span><span class="money" title="Your money (only you
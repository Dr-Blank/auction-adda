// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`home > renders the start page with a saved name and rooms 1`] = `"<main class="center-card home"><h1 class="brand"><a class="brand-link" href="/" title="Home">Game Adda</a></h1><p class="muted">Card and board games for friends on voice chat. Everyone joins from their own device.</p><section class="my-rooms" aria-label="Your rooms"><h2>Your rooms</h2><ul><li class="my-room"><span class="grow"><span class="my-room-head"><span class="admin-mark" title="You are the admin">★</span><b>Box Office</b><span class="room-code"><b class="code">ABC234</b><button type="button" class="copy-code " title="Copy room code" aria-label="Copy room code"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon"><rect x="9" y="9" width="11" height="11" rx="2.5"></rect><path d="M5 15V6.5A2.5 2.5 0 0 1 7.5 4H15"></path></svg></button></span></span><small class="muted">Summer · season 2 of 4 · Asha (you), Bilal, Chitra</small><small class="expiry muted">Active 1 min ago · deleted in 6 days</small></span><a class="btn small" href="#ABC234">Rejoin</a></li></ul><p class="muted small">A room is deleted 6 days after anything last happened in it. Opening it and playing keeps it.</p></section><form><div class="you-row"><button type="button" class="avatar-btn look-btn" aria-haspopup="dialog" aria-label="Change your picture" title="Change your picture"><span class="avatar big" style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#553ae3fb</svg></span><span class="look-edit" aria-hidden="true">✎</span></button><label>Your name<input maxlength="20" placeholder="e.g. Chintu" value="Asha"></label></div><fieldset><legend>Theme</legend><h3 class="theme-game">Auction Adda</h3><label class="theme-pick on"><input type="radio" checked="" name="theme"><span><b>Box Office</b><small>Buy films, back the right star, sell them when the season ends.</small></span></label><label class="theme-pick "><input type="radio" name="theme"><span><b>Leather &amp; Willow</b><small>Bid for cricketers, back the right franchise, cash in when the tournament ends.</small></span></label><h3 class="theme-game">Pahunch</h3><label class="theme-pick "><input type="radio" name="theme"><span><b>Society Committee</b><small>Climb the housing society’s committees to the Chairman’s cabin. Votes have a price.</small></span></label></fieldset><button class="btn primary big">Create a room</button></form><form class="join-row"><label>Or join with a room code<input maxlength="6" placeholder="ABC234" class="code-input" value=""></label><button class="btn" disabled="">Join</button></form><p class="muted"><small>Free software under the AGPL-3.0. <a href="https://github.com/Dr-Blank/auction-adda">Source code</a></small></p></main>"`;

exports[`pahunch pages > ended-early 1`] = `"<div class="table ph-table  "><header class="topbar"><span class="brand"><a class="brand-link" href="/" title="Home">Game Adda</a></span><span class="round"><b>Final result</b> · Chairman’s cabin 0/5</span><span class="grow"></span><button class="icon-btn" title="What happened" aria-label="Log">☰ <span class="lbl">Log</span></button><button class="icon-btn" title="Sound on" aria-label="Turn sound off">🔊</button><button class="icon-btn" aria-expanded="false" title="Room and rules" aria-label="Room and rules">? <span class="lbl">Room</span></button></header><div class="notices"></div><section class="seats ph-players" aria-label="Players"><div class="seat ph-seat-chip    " data-seat="0" style="--seat: #e4572e; --seat-ink: #1a0d08;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About Bilal"><span class="avatar on" style="background: linear-gradient(170deg, #e3ecf7, #c4d4ec);"><svg viewBox="0 0 100 100" aria-hidden="true">#b20bad4c</svg></span></button><span class="ph-swatch" aria-hidden="true">B</span></div><div class="seat-body"><div class="seat-name">Bilal</div><div class="seat-line ph-counts"><span title="residents still to place">✋ 3</span><span title="residents in the Chairman’s cabin">▲ 0</span><b class="ph-points" title="izzat">3 izzat</b></div></div></div><div class="seat ph-seat-chip    " data-seat="1" style="--seat: #4ea5d9; --seat-ink: #06141c;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About Chitra"><span class="avatar on" style="background: linear-gradient(170deg, #e6f2e3, #c3ddbf);"><svg viewBox="0 0 100 100" aria-hidden="true">#f53baf90</svg></span></button><span class="ph-swatch" aria-hidden="true">C</span></div><div class="seat-body"><div class="seat-name">Chitra</div><div class="seat-line ph-counts"><span title="residents still to place">✋ 2</span><span title="residents in the Chairman’s cabin">▲ 0</span><b class="ph-points" title="izzat">2 izzat</b></div></div></div><div class="seat ph-seat-chip me   " data-seat="2" style="--seat: #8cc152; --seat-ink: #0f1a06;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About your seat"><span class="avatar on" style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#2bb40ffe</svg></span></button><span class="ph-swatch" aria-hidden="true">A</span><div class="react-bar"><button type="button" class="react-badge " aria-expanded="false" title="React: float an emoji over your seat" aria-label="React"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon"><circle cx="12" cy="12" r="8.5"></circle><path d="M8.5 14a4.2 4.2 0 0 0 7 0"></path><path d="M9.5 9.8h0M14.5 9.8h0" stroke-width="2.6"></path></svg></button></div></div><div class="seat-body"><div class="seat-name">You<span class="admin-mark">★</span></div><div class="seat-line ph-counts"><span title="residents still to place">✋ 3</span><span title="residents in the Chairman’s cabin">▲ 0</span><b class="ph-points" title="izzat">2 izzat</b></div></div></div><div class="seat ph-seat-chip    " data-seat="3" style="--seat: #c18ae0; --seat-ink: #1a0c22;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About Dev"><span class="avatar on" style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#0fd19d14</svg></span></button><span class="ph-swatch" aria-hidden="true">D</span></div><div class="seat-body"><div class="seat-name">Dev</div><div class="seat-line ph-counts"><span title="residents still to place">✋ 5</span><span title="residents in the Chairman’s cabin">▲ 0</span><b class="ph-points" title="izzat">6 izzat</b></div></div></div></section><section class="stage ph-stage "><div class="ph-ended"><h2>Game ended early</h2><p>Asha ended the game. Nobody wins a game that stops before the Chairman’s cabin is full.</p><ol class="also-ran"><li><span>Dev</span><b>6 izzat</b></li><li><span>Bilal</span><b>3 izzat</b></li><li><span>Chitra</span><b>2 izzat</b></li><li><span>Asha<em> (you)</em></span><b>2 izzat</b></li></ol><div class="row gameover-next"><button type="button" class="btn primary big">Play again</button><button type="button" class="btn big">Change setup</button></div></div></section><aside class="side ph-side"><section class="ph-purse" aria-label="Your izzat"><h2>Your izzat <b>2</b></h2><div class="ph-tokens"><span class="ph-chip v1">1</span><span class="ph-chip v1">1</span></div><p class="muted small">Everyone’s tokens show now.</p></section><section class="recent" aria-label="Latest"><h2>Latest</h2><ol><li class="log-end">You ended the game early. Nobody wins.</li><li class="log-fail">The vote failed: you stay in the Parking sub-committee.</li><li class="log-vote">Chitra voted yes.</li><li class="log-vote">Bilal voted no.</li><li class="log-ask">You asked to move up from the Parking sub-committee to the Garden committee: 4 votes needed.</li><li class="log-enter">Chitra joined the Lift committee.</li></ol><button class="btn small ghost">Full log</button></section></aside></div>"`;

exports[`pahunch pages > lobby-admin 1`] = `"<main class="center-card lobby"><h1 class="brand"><a class="brand-link" href="/" title="Home">Game Adda</a></h1><p class="muted">Society Committee · room <span class="room-code"><b class="code">ZVKXX3</b><button type="button" class="copy-code " title="Copy room code" aria-label="Copy room code"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon"><rect x="9" y="9" width="11" height="11" rx="2.5"></rect><path d="M5 15V6.5A2.5 2.5 0 0 1 7.5 4H15"></path></svg></button></span></p><p>Paste this link in Discord. Everyone who opens it lands in this room.</p><div class="share"><input readonly="" aria-label="Room link" value="http://localhost:3000/#ZVKXX3"><button class="btn">Copy link</button><button class="btn share-btn" title="Show the link as a QR code" aria-label="Show the room link as a QR code"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon">#b80ee5a5</svg></button></div><fieldset><legend>Theme</legend><h3 class="theme-game">Auction Adda</h3><label class="theme-pick "><input type="radio" name="theme"><span><b>Box Office</b><small>Buy films, back the right star, sell them when the season ends.</small></span></label><label class="theme-pick "><input type="radio" name="theme"><span><b>Leather &amp; Willow</b><small>Bid for cricketers, back the right franchise, cash in when the tournament ends.</small></span></label><h3 class="theme-game">Pahunch</h3><label class="theme-pick on"><input type="radio" checked="" name="theme"><span><b>Society Committee</b><small>Climb the housing society’s committees to the Chairman’s cabin. Votes have a price.</small></span></label></fieldset><h2>Players <small>(3–5)</small></h2><ol class="lobby-seats"><li class=" me"><span class="avatar-wrap"><button type="button" class="avatar-btn look-btn" aria-haspopup="dialog" aria-label="Change your picture" title="Change your picture"><span class="avatar on" style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#2bb40ffe</svg></span><span class="look-edit" aria-hidden="true">✎</span></button><div class="react-bar"><button type="button" class="react-badge " aria-expanded="false" title="React: float an emoji over your seat" aria-label="React"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon"><circle cx="12" cy="12" r="8.5"></circle><path d="M8.5 14a4.2 4.2 0 0 0 7 0"></path><path d="M9.5 9.8h0M14.5 9.8h0" stroke-width="2.6"></path></svg></button></div></span><span class="grow"><b>Asha</b><span class="admin-mark" title="Room admin">★</span><em> (you)</em></span></li><li class=" "><span class="avatar on" title="Connected" style="background: linear-gradient(170deg, #e3ecf7, #c4d4ec);"><svg viewBox="0 0 100 100" aria-hidden="true">#b20bad4c</svg></span><span class="grow"><b>Bilal</b></span><span class="ready-mark">not ready</span><button class="btn small">Kick</button></li><li class=" "><span class="avatar on" title="Connected" style="background: linear-gradient(170deg, #e6f2e3, #c3ddbf);"><svg viewBox="0 0 100 100" aria-hidden="true">#f53baf90</svg></span><span class="grow"><b>Chitra</b></span><span class="ready-mark">not ready</span><button class="btn small">Kick</button></li><li class=" "><span class="avatar on" title="Connected" style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#0fd19d14</svg></span><span class="grow"><b>Dev</b></span><span class="ready-mark">not ready</span><button class="btn small">Kick</button></li><li class="empty"><span class="avatar empty" aria-hidden="true"></span><span class="grow">Empty seat</span><button class="btn small">Add a bot</button></li></ol><section class="watchers"><h3>Watching <small class="muted">(1)</small></h3><ul><li class=""><span class="grow">Esha</span><button type="button" class="btn small ">Remove</button></li></ul></section><p class="admin-note"><span class="admin-mark">★</span> <b>You are the room admin.</b> The admin starts the game and can fill empty seats with bots. The admin can skip an away player's move (a random move is made for them) and set a clock for votes. Hand the role over any time from the Room menu.</p><details class="advanced"><summary>Advanced <small class="muted">room settings, vote clock</small></summary><p class="muted small">Your browser keeps what you pick here for the next room you create.</p><div class="room-settings"><h3>Room settings</h3><label class="toggle "><input role="switch" type="checkbox"><span><span><b>Lock room</b></span><small class="muted">Nobody new takes a seat. People with the link can still watch.</small></span></label><label class="toggle "><input role="switch" type="checkbox"><span><span><b>Anyone may freeze</b></span><small class="muted">Every player can freeze the game, which stops the clock, the bots and all moves. Whoever froze it, or the admin, lets it run again.</small></span></label><label class="toggle "><input role="switch" type="checkbox"><span><span><b>Players may rename</b></span><small class="muted">Everyone with a seat can change their name, in the lobby and during the game.</small></span></label><label class="toggle "><input role="switch" type="checkbox"><span><span><b>New seats each round</b></span><small class="muted">Seats are drawn at random when a game starts. With this on, they are drawn again at the start of every round.</small></span></label><div class="reaction-set"><span><b>Reactions</b></span><small class="muted">Players float these over their seat. Pick up to 8; none turns reactions off.</small><div class="reaction-choices" role="group" aria-label="Reactions on offer"><button type="button" class="chip-btn on" aria-pressed="true">👏</button><button type="button" class="chip-btn on" aria-pressed="true">😂</button><button type="button" class="chip-btn on" aria-pressed="true">😮</button><button type="button" class="chip-btn on" aria-pressed="true">🔥</button><button type="button" class="chip-btn on" aria-pressed="true">😬</button><button type="button" class="chip-btn on" aria-pressed="true">🙏</button><button type="button" class="chip-btn " aria-pressed="false">🎉</button><button type="button" class="chip-btn " aria-pressed="false">😭</button><button type="button" class="chip-btn " aria-pressed="false">🤔</button><button type="button" class="chip-btn " aria-pressed="false">😎</button><button type="button" class="chip-btn " aria-pressed="false">💸</button><button type="button" class="chip-btn " aria-pressed="false">🤑</button><button type="button" class="chip-btn " aria-pressed="false">🙈</button><button type="button" class="chip-btn " aria-pressed="false">👀</button><button type="button" class="chip-btn " aria-pressed="false">💀</button><button type="button" class="chip-btn " aria-pressed="false">❤️</button><button type="button" class="chip-btn " aria-pressed="false">👍</button><button type="button" class="chip-btn " aria-pressed="false">👎</button><button type="button" class="chip-btn " aria-pressed="false">🤝</button><button type="button" class="chip-btn " aria-pressed="false">😤</button><button type="button" class="btn small">Turn off</button></div></div></div><div class="bid-timer"><h3>Board</h3><p><b>Classic</b></p><small class="muted">More boards are coming.</small></div><div class="bid-timer"><h3>Vote clock</h3><label>For each vote <select aria-label="Vote clock"><option value="0">No limit</option><option value="15">15 s</option><option value="20">20 s</option><option value="30">30 s</option><option value="45">45 s</option><option value="60">1 min</option><option value="90">90 s</option><option value="120">2 min</option><option value="180">3 min</option><option value="300">5 min</option></select></label><label>After an answer, at least <select aria-label="Time after an answer"><option value="3">3 s</option><option value="5">5 s</option><option value="10">10 s</option><option value="15">15 s</option><option value="20">20 s</option><option value="30">30 s</option><option value="60">1 min</option></select></label><small class="muted">Voters have 30 s to answer. When it runs out, whoever has not answered says no.</small></div></details><div class="row"><button class="btn primary big grow">Start with 4 players · 0 of 3 ready</button><button class="btn">Leave</button></div><p class="muted small">You start when everyone is ready (or before, if you must). Seats are drawn at random when the game begins, and nobody new sits down after that.</p><div class="row room-danger"><button type="button" class="btn small ">Close room</button></div><section class="rules"><h2>How to play</h2><p>Everyone in the society wants the Chairman’s cabin. Committees only let a resident move up when most of their members agree, so votes are traded for izzat, promises are made on the call, and the aunties can always be persuaded with a box of kaju katli. The watchman lets anyone through his gate without a vote, but then nobody pays for it.</p><h3>Your turn: one move</h3><ul><li><b>Add</b> a resident from your hand to a bottom room with a free seat.</li><li><b>Move up</b> one of your residents, along a path to the room above, if it has a free seat. Leaving a room takes yes votes from more than half its seats (2 of 3, 3 of 5, 4 of 7; a room of one is free).</li><li><b>Nudge</b> an aunty up a path, no vote needed, and take 1 izzat. aunties never reach the Chairman’s cabin.</li><li><b>Send the watchman</b> to another path.</li></ul><h3>Votes</h3><ul><li>Your own residents in the room say yes. Each other player answers for theirs: yes with some, or no.</li><li>Each yes the climb needed earns the player who gave it 1 izzat.</li><li>An aunty says yes only for a box of kaju katli: you pay one of your tokens worth 2 or more, and it leaves the game.</li><li>The path with the watchman on it needs no vote at all, but whoever goes that way takes nothing from it.</li><li>If the vote fails, or you give up, your resident stays and your turn ends.</li></ul><h3>izzat</h3><ul><li>Moving up out of a room of 3 or more takes the token lying on the path; a new one is drawn for it. Only you see your izzat until the game ends.</li><li>Give tokens to anyone, at any time. Deals are made on the call and nothing makes anyone keep them.</li></ul><h3>The end</h3><p>The game ends the moment the Chairman’s cabin is full. Only players with a resident there can win: the most izzat wins, and a tie goes to whoever got there first. If the admin ends the game early, nobody wins.</p></section></main>"`;

exports[`pahunch pages > over 1`] = `"<div class="table ph-table  "><header class="topbar"><span class="brand"><a class="brand-link" href="/" title="Home">Game Adda</a></span><span class="round"><b>Final result</b> · Chairman’s cabin 5/5</span><span class="grow"></span><button class="icon-btn" title="What happened" aria-label="Log">☰ <span class="lbl">Log</span></button><button class="icon-btn" title="Sound on" aria-label="Turn sound off">🔊</button><button class="icon-btn" aria-expanded="false" title="Room and rules" aria-label="Room and rules">? <span class="lbl">Room</span></button></header><div class="notices"></div><section class="seats ph-players" aria-label="Players"><div class="seat ph-seat-chip    " data-seat="0" style="--seat: #e4572e; --seat-ink: #1a0d08;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About Bilal"><span class="avatar on" style="background: linear-gradient(170deg, #e3ecf7, #c4d4ec);"><svg viewBox="0 0 100 100" aria-hidden="true">#b20bad4c</svg></span></button><span class="ph-swatch" aria-hidden="true">B</span></div><div class="seat-body"><div class="seat-name">Bilal</div><div class="seat-line ph-counts"><span title="residents still to place">✋ 0</span><span title="residents in the Chairman’s cabin">▲ 1</span><b class="ph-points" title="izzat">12 izzat</b></div></div></div><div class="seat ph-seat-chip me   " data-seat="1" style="--seat: #4ea5d9; --seat-ink: #06141c;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About your seat"><span class="avatar on" style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#2bb40ffe</svg></span></button><span class="ph-swatch" aria-hidden="true">A</span><div class="react-bar"><button type="button" class="react-badge " aria-expanded="false" title="React: float an emoji over your seat" aria-label="React"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon"><circle cx="12" cy="12" r="8.5"></circle><path d="M8.5 14a4.2 4.2 0 0 0 7 0"></path><path d="M9.5 9.8h0M14.5 9.8h0" stroke-width="2.6"></path></svg></button></div></div><div class="seat-body"><div class="seat-name">You<span class="admin-mark">★</span></div><div class="seat-line ph-counts"><span title="residents still to place">✋ 0</span><span title="residents in the Chairman’s cabin">▲ 1</span><b class="ph-points" title="izzat">16 izzat</b></div></div></div><div class="seat ph-seat-chip    " data-seat="2" style="--seat: #8cc152; --seat-ink: #0f1a06;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About Dev"><span class="avatar on" style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#0fd19d14</svg></span></button><span class="ph-swatch" aria-hidden="true">D</span></div><div class="seat-body"><div class="seat-name">Dev</div><div class="seat-line ph-counts"><span title="residents still to place">✋ 2</span><span title="residents in the Chairman’s cabin">▲ 2</span><b class="ph-points" title="izzat">13 izzat</b></div></div></div><div class="seat ph-seat-chip    winner" data-seat="3" style="--seat: #c18ae0; --seat-ink: #1a0c22;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About Chitra"><span class="avatar on" style="background: linear-gradient(170deg, #e6f2e3, #c3ddbf);"><svg viewBox="0 0 100 100" aria-hidden="true">#f53baf90</svg></span></button><span class="ph-swatch" aria-hidden="true">C</span></div><div class="seat-body"><div class="seat-name">Chitra<span title="Winner"> 👑</span></div><div class="seat-line ph-counts"><span title="residents still to place">✋ 0</span><span title="residents in the Chairman’s cabin">▲ 1</span><b class="ph-points" title="izzat">19 izzat</b></div></div></div></section><section class="stage ph-stage
exports[`pahunch at seven seats (the other side of the board) > your-move 1`] = `"<div class="table ph-table acting "><header class="topbar"><span class="brand"><a class="brand-link" href="/" title="Home">Game Adda</a></span><span class="round"><b>You to move</b> · 👑 Chairman’s cabin 0/7</span><span class="grow"></span><button class="icon-btn" title="Freeze the game: the clock, the bots and all moves wait" aria-label="Freeze the game"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon"><path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9"></path><path d="M9.5 4.5L12 7l2.5-2.5M9.5 19.5L12 17l2.5 2.5"></path></svg> <span class="lbl">Freeze</span></button><button class="icon-btn" title="What happened" aria-label="Log">☰ <span class="lbl">Log</span></button><button class="icon-btn" title="Sound on" aria-label="Turn sound off">🔊</button><button class="icon-btn" aria-expanded="false" title="Room and rules" aria-label="Room and rules">? <span class="lbl">Room</span></button></header><div class="notices"></div><section class="seats ph-players many" aria-label="Players"><div class="seat ph-seat-chip    " data-seat="1" style="--seat: #4ea5d9; --seat-ink: #06141c;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About Farhan"><span class="avatar on" style="background: linear-gradient(170deg, #fdf1cf, #f0d993);"><svg viewBox="0 0 100 100" aria-hidden="true">#bd75d897</svg></span></button><svg class="ph-swatch" viewBox="-1.6 -1.6 3.2 3.2" aria-hidden="true"><path d="M0.00 -1.09L0.95 0.55L-0.95 0.55Z"></path></svg></div><button class="seat-body ph-seat-more" aria-haspopup="dialog"><span class="seat-name">Farhan</span><span class="seat-line ph-counts"><span role="img" aria-label="5 still to place">✋ 5</span><span role="img" aria-label="0 at the top">▲ 0</span></span></button><button type="button" class="ph-fav-btn  live"
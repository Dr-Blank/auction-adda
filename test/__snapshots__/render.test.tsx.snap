up="dialog" aria-label="About your seat"><span class="avatar on" style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#2bb40ffe</svg></span></button><span class="ph-swatch" aria-hidden="true">A</span><div class="react-bar"><button type="button" class="react-badge " aria-expanded="false" title="React: float an emoji over your seat" aria-label="React"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon"><circle cx="12" cy="12" r="8.5"></circle><path d="M8.5 14a4.2 4.2 0 0 0 7 0"></path><path d="M9.5 9.8h0M14.5 9.8h0" stroke-width="2.6"></path></svg></button></div></div><div class="seat-body"><div class="seat-name">You<span class="admin-mark">★</span></div><div class="seat-line ph-counts"><span title="residents still to place">✋ 1</span><span title="residents in the Chairman’s cabin">▲ 0</span><b class="ph-points" title="izzat">8 izzat</b></div></div></div><div class="seat ph-seat-chip    " data-seat="2" style="--seat: #8cc152; --seat-ink: #0f1a06;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About Dev"><span class="avatar on" style="background: linear-gradient(170deg, #f4e1ea, #e3bfd0);"><svg viewBox="0 0 100 100" aria-hidden="true">#0fd19d14</svg></span></button><span class="ph-swatch" aria-hidden="true">D</span></div><div class="seat-body"><div class="seat-name">Dev</div><div class="seat-line ph-counts"><span title="residents still to place">✋ 3</span><span title="residents in the Chairman’s cabin">▲ 1</span></div></div></div><div class="seat ph-seat-chip    " data-seat="3" style="--seat: #c18ae0; --seat-ink: #1a0c22;"><div class="avatar-wrap"><button class="avatar-btn" aria-haspopup="dialog" aria-label="About Chitra"><span class="avatar on" style="background: linear-gradient(170deg, #e6f2e3, #c3ddbf);"><svg viewBox="0 0 100 100" aria-hidden="true">#f53baf90</svg></span></button><span class="ph-swatch" aria-hidden="true">C</span></div><div class="seat-body"><div class="seat-name">Chitra</div><div class="seat-line ph-counts"><span title="residents still to place">✋ 0</span><span title="residents in the Chairman’s cabin">▲ 0</span></div></div></div></section><section class="stage ph-stage "><div class="ph-vote" aria-live="polite"><h2>Chitra wants to move up from the Festival committee to the Security committee</h2><p class="ph-tally"><b>1</b> yes so far, <b>3</b> needed<span class="ph-clock"> · ⏱ 12 s</span></p><ul class="ph-voters"><li style="--seat: #e4572e;"><span class="ph-dot" aria-hidden="true"></span>Bilal ×1: <em>thinking…</em></li><li style="--seat: #4ea5d9;"><span class="ph-dot" aria-hidden="true"></span>You ×2: no</li><li style="--seat: #c18ae0;"><span class="ph-dot" aria-hidden="true"></span>Chitra ×1: yes (own)</li></ul></div><svg class="ph-board" viewBox="-3.3000000000000007 -1.5 103.89999999999999 101" role="group" aria-label="The board: Classic">#a8cc5e26</svg><div class="action-bar "></div></section><aside class="side ph-side"><section class="ph-purse" aria-label="Your izzat"><h2>Your izzat <b>8</b></h2><div class="ph-tokens"><span class="ph-chip v1">1</span><span class="ph-chip v1">1</span><span class="ph-chip v1">1</span><span class="ph-chip v1">1</span><span class="ph-chip v2">2</span><span class="ph-chip v2">2</span></div><p class="muted small">Only you see these until the game ends.</p><button class="btn small">Give tokens…</button></section><section class="recent" aria-label="Latest"><h2>Latest</h2><ol><li class="log-vote">You voted no.</li><li class="log-ask">Chitra asked to move up from the Festival committee to the Security committee: 3 votes needed.</li><li class="log-fail">The vote failed: Dev stays in the Festival committee.</li><li class="log-vote">You voted no.</li><li class="log-ask">Dev asked to move up from the Lift committee to the Garden committee: 2 votes needed.</li><li